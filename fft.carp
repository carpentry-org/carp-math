(load "complex.carp")

(use Array)
(use Double)
(use Result)

(defmodule FFT
  (doc power-of-two? "checks if `n` is a power of two.")
  (defn power-of-two? [n] (and (> n 0) (= 0 (Int.bit-and n (- n 1)))))

  (doc next-power-of-two
    "finds the smallest power of two greater than or equal to `n`.")
  (defn next-power-of-two [n]
    (let-do [res 1] (while (< res n) (set! res (* res 2))) res))

  (doc bit-reverse-permute!
    "performs an in-place bit-reversal permutation on the array.")
  (defn bit-reverse-permute! [arr]
    (let [n (Array.length arr)
          j 0]
      (do
        (for [i 0 n]
          (do
            (when (< i j)
              (let [temp @(Array.unsafe-nth arr i)]
                (do
                  (Array.aset! arr i @(Array.unsafe-nth arr j))
                  (Array.aset! arr j temp))))
            (let [m (/ n 2)]
              (do
                (while (and (> m 0) (>= j m))
                  (do (set! j (- j m)) (set! m (/ m 2))))
                (set! j (+ j m)))))))))

  (doc fft!
    "performs a 1D Cooley-Tukey Radix-2 FFT in-place on the given array of complex numbers. Set `inverse` to true for IFFT. Asserts that the length of the array is a power of two.")
  (defn fft! [arr inverse]
    (let [n (Array.length arr)]
      (do
        (assert (power-of-two? n))
        ;; 1. Bit-reversal permutation
        (bit-reverse-permute! arr)

        ;; 2. Cooley-Tukey decimation-in-time
        (let [len 2]
          (while (<= len n)
            (let [ang (*
                    (/ (* 2.0 Double.pi) (Double.from-int len))
                    (if inverse 1.0 -1.0))
                  wlen (Complex.from-polar 1.0 ang)
                  half-len (/ len 2)]
              (do
                (let [i 0]
                  (while (< i n)
                    (let [w (Complex.one)]
                      (do
                        (for [j 0 half-len]
                          (let [u-idx (+ i j)
                                v-idx (+ (+ i j) half-len)
                                u @(Array.unsafe-nth arr u-idx)
                                v (Complex.* &w (Array.unsafe-nth arr v-idx))
                                t-add (Complex.+ &u &v)
                                t-sub (Complex.- &u &v)]
                            (do
                              (Array.aset! arr u-idx t-add)
                              (Array.aset! arr v-idx t-sub)
                              (set! w (Complex.* &w &wlen)))))
                        (set! i (+ i len))))))
                (set! len (* len 2))))))

        ;; 3. Scale if inverse
        (when inverse
          (let [scale-factor (/ 1.0 (Double.from-int n))]
            (for [i 0 n]
              (let [val @(Array.unsafe-nth arr i)
                    scaled (Complex.init (* @(Complex.real &val) scale-factor)
                                         (* @(Complex.imag &val) scale-factor))]
                (Array.aset! arr i scaled))))))))

  (doc try-fft
    "attempts to perform a 1D FFT on the array of complex numbers, returning a Result.")
  (defn try-fft [arr]
    (let [n (Array.length arr)]
      (if (not (power-of-two? n))
        (Error @"Array length must be a power of two")
        (let [copy-arr @arr] (do (fft! &copy-arr false) (Success copy-arr))))))

  (doc try-ifft
    "attempts to perform a 1D inverse FFT on the array of complex numbers, returning a Result.")
  (defn try-ifft [arr]
    (let [n (Array.length arr)]
      (if (not (power-of-two? n))
        (Error @"Array length must be a power of two")
        (let [copy-arr @arr] (do (fft! &copy-arr true) (Success copy-arr))))))

  (doc fft
    "performs a 1D FFT on the array of complex numbers. Asserts that the length is a power of two.")
  (defn fft [arr] (let [copy-arr @arr] (do (fft! &copy-arr false) copy-arr)))

  (doc ifft
    "performs a 1D inverse FFT on the array of complex numbers. Asserts that the length is a power of two.")
  (defn ifft [arr] (let [copy-arr @arr] (do (fft! &copy-arr true) copy-arr)))

  (doc rfft
    "performs a Real FFT on the given array of real numbers, returning the full complex spectrum. Asserts that the length is a power of two.")
  (defn rfft [arr]
    (let [n (Array.length arr)]
      (do
        (assert (power-of-two? n))
        (let [c-arr (replicate n &(Complex.zero))]
          (do
            (for [i 0 n]
              (Array.aset! &c-arr i (Complex.init @(Array.unsafe-nth arr i) 0.0)))
            (fft! &c-arr false)
            c-arr)))))

  (doc rfft-one-sided
    "performs a Real FFT on the given array of real numbers, returning only the one-sided complex spectrum (first N/2 + 1 elements). Asserts that the length is a power of two.")
  (defn rfft-one-sided [arr]
    (let [full (rfft arr)
          n (Array.length &full)
          out-len (+ (/ n 2) 1)
          half-arr (replicate out-len &(Complex.zero))]
      (do
        (for [i 0 out-len] (Array.aset! &half-arr i @(Array.unsafe-nth &full i)))
        half-arr)))

  (doc irfft
    "reconstructs a real signal from its one-sided complex spectrum of size M = N/2 + 1, enforcing Hermitian symmetry and running an inverse FFT.")
  (defn irfft [arr]
    (let [m (Array.length arr)
          n (* (- m 1) 2)
          full (replicate n &(Complex.zero))]
      (do
        (assert (power-of-two? n))
        ;; Reconstruct Hermitian symmetry
        (Array.aset! &full 0 @(Array.unsafe-nth arr 0))
        (Array.aset! &full (/ n 2) @(Array.unsafe-nth arr (- m 1)))
        (for [k 1 (/ n 2)]
          (let [val (Array.unsafe-nth arr k)
                c-val (Complex.conj val)]
            (do (Array.aset! &full k @val) (Array.aset! &full (- n k) c-val))))

        ;; Perform inverse FFT
        (fft! &full true)

        ;; Extract real parts
        (let [r-arr (replicate n &0.0)]
          (do
            (for [i 0 n]
              (Array.aset! &r-arr i @(Complex.real (Array.unsafe-nth &full i))))
            r-arr)))))

  (doc fft2d!
    "performs a 2D Cooley-Tukey Radix-2 FFT in-place on the given flat array representing a 2D grid of size rows x cols.")
  (defn fft2d! [arr rows cols inverse]
    (do
      ;; 1. FFT on each row
      (let [row-arr (replicate cols &(Complex.zero))]
        (for [r 0 rows]
          (do
            ;; Copy row elements to temporary array
            (for [c 0 cols]
              (Array.aset! &row-arr c @(Array.unsafe-nth arr (+ (* r cols) c))))
            ;; Perform 1D FFT in-place on row
            (fft! &row-arr inverse)
            ;; Write back row
            (for [c 0 cols]
              (Array.aset! arr (+ (* r cols) c) @(Array.unsafe-nth &row-arr c))))))

      ;; 2. FFT on each col
      (let [col-arr (replicate rows &(Complex.zero))]
        (for [c 0 cols]
          (do
            ;; Copy col elements to temporary array
            (for [r 0 rows]
              (Array.aset! &col-arr r @(Array.unsafe-nth arr (+ (* r cols) c))))
            ;; Perform 1D FFT in-place on col
            (fft! &col-arr inverse)
            ;; Write back col
            (for [r 0 rows]
              (Array.aset! arr (+ (* r cols) c) @(Array.unsafe-nth &col-arr r))))))))

  (doc try-fft2d
    "attempts to perform a 2D FFT on a flat array of size rows x cols, returning a Result.")
  (defn try-fft2d [arr rows cols]
    (let [n (Array.length arr)]
      (if (not (= n (* rows cols)))
        (Error @"Array size does not match rows * cols")
        (if (or (not (power-of-two? rows)) (not (power-of-two? cols)))
          (Error @"Rows and columns must be powers of two")
          (let [copy-arr @arr]
            (do (fft2d! &copy-arr rows cols false) (Success copy-arr)))))))

  (doc try-ifft2d
    "attempts to perform a 2D inverse FFT on a flat array of size rows x cols, returning a Result.")
  (defn try-ifft2d [arr rows cols]
    (let [n (Array.length arr)]
      (if (not (= n (* rows cols)))
        (Error @"Array size does not match rows * cols")
        (if (or (not (power-of-two? rows)) (not (power-of-two? cols)))
          (Error @"Rows and columns must be powers of two")
          (let [copy-arr @arr]
            (do (fft2d! &copy-arr rows cols true) (Success copy-arr)))))))

  (doc fft2d
    "performs a 2D FFT on a flat array of size rows x cols. Asserts size and powers of two.")
  (defn fft2d [arr rows cols]
    (let [copy-arr @arr]
      (do
        (assert (= (Array.length arr) (* rows cols)))
        (assert (power-of-two? rows))
        (assert (power-of-two? cols))
        (fft2d! &copy-arr rows cols false)
        copy-arr)))

  (doc ifft2d
    "performs a 2D inverse FFT on a flat array of size rows x cols. Asserts size and powers of two.")
  (defn ifft2d [arr rows cols]
    (let [copy-arr @arr]
      (do
        (assert (= (Array.length arr) (* rows cols)))
        (assert (power-of-two? rows))
        (assert (power-of-two? cols))
        (fft2d! &copy-arr rows cols true)
        copy-arr)))

  (doc pad-zero "pads a real array with zeros to the specified new length.")
  (defn pad-zero [arr new-len]
    (let [old-len (Array.length arr)
          out (replicate new-len &0.0)]
      (do
        (assert (>= new-len old-len))
        (for [i 0 old-len] (Array.aset! &out i @(Array.unsafe-nth arr i)))
        out)))

  (doc pad-zero-complex
    "pads a complex array with complex zeros to the specified new length.")
  (defn pad-zero-complex [arr new-len]
    (let [old-len (Array.length arr)
          out (replicate new-len &(Complex.zero))]
      (do
        (assert (>= new-len old-len))
        (for [i 0 old-len] (Array.aset! &out i @(Array.unsafe-nth arr i)))
        out)))

  (doc fftshift
    "shifts the zero-frequency component to the center of the spectrum.")
  (defn fftshift [arr]
    (let [n (Array.length arr)
          half (/ (+ n 1) 2)
          out (replicate n (Array.unsafe-nth arr 0))]
      (do
        (for [i 0 n]
          (Array.aset! &out (Int.mod (+ i half) n) @(Array.unsafe-nth arr i)))
        out)))

  (doc ifftshift
    "shifts the zero-frequency component back from the center of the spectrum.")
  (defn ifftshift [arr]
    (let [n (Array.length arr)
          half (/ n 2)
          out (replicate n (Array.unsafe-nth arr 0))]
      (do
        (for [i 0 n]
          (Array.aset! &out (Int.mod (+ i half) n) @(Array.unsafe-nth arr i)))
        out)))

  (doc frequency-axis
    "generates the positive frequency bins (size N/2 + 1) for a real FFT of length `n` and sampling rate `sample-rate`.")
  (defn frequency-axis [n sample-rate]
    (let [out-len (+ (/ n 2) 1)
          out (replicate out-len &0.0)
          df (/ sample-rate (Double.from-int n))]
      (do
        (for [i 0 out-len] (Array.aset! &out i (* (Double.from-int i) df)))
        out)))

  (doc frequency-axis-full
    "generates the full frequency bins (size N) for a complex FFT of length `n` and sampling rate `sample-rate`.")
  (defn frequency-axis-full [n sample-rate]
    (let [out (replicate n &0.0)
          df (/ sample-rate (Double.from-int n))
          half (/ n 2)]
      (do
        (for [i 0 half] (Array.aset! &out i (* (Double.from-int i) df)))
        (for [i half n] (Array.aset! &out i (* (Double.from-int (- i n)) df)))
        out))))
