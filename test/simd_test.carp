(load "Test.carp")
(use Test)
(load "simd.carp")
(load "simd_array.carp")
(use Simd)
(use SimdArray)

(deftest simd-test
  (let [state (Test.State.init 0 0)
        v1 (Simd.init-4 1f 2f 3f 4f)
        v2 (Simd.init-4 10f 20f 30f 40f)
        align (Simd.alignment)
        raw-data (Simd.alloc-aligned (Simd.width) align)
        data (Simd.alloc-aligned (Simd.width) align)]
    (do
      ;; Populate raw-data buffer
      (for [i 0 (Simd.width)]
        (Pointer.set (Pointer.add raw-data (Long.from-int i))
                     (Float.from-int (+ i 100))))

      ;; 1. Initialization and Getter tests
      (set! state (assert-equal &state 1f (Simd.get v1 0) "Get idx 0 is 1.0"))
      (set! state (assert-equal &state 2f (Simd.get v1 1) "Get idx 1 is 2.0"))
      (set! state (assert-equal &state 3f (Simd.get v1 2) "Get idx 2 is 3.0"))
      (set! state (assert-equal &state 4f (Simd.get v1 3) "Get idx 3 is 4.0"))

      ;; Verify padding on AVX/AVX-512 (lanes >= 4 are 0.0f)
      (when (> (Simd.width) 4)
        (for [i 4 (Simd.width)]
          (set! state
                (assert-equal &state 0f (Simd.get v1 i) "Padding lanes are 0.0f"))))

      ;; 2. Basic Arithmetic and Operators
      (let [v-add (+ v1 v2)
            v-sub (- v2 v1)
            v-mul (* v1 v2)
            v-div (/ v2 v1)
            v-neg (neg v1)]
        (do
          (set! state
                (assert-equal &state
                  11f
                  (Simd.get v-add 0)
                  "Add (+) idx 0 is 11.0"))
          (set! state
                (assert-equal &state
                  44f
                  (Simd.get v-add 3)
                  "Add (+) idx 3 is 44.0"))
          (set! state
                (assert-equal &state
                  9f
                  (Simd.get v-sub 0)
                  "Sub (-) idx 0 is 9.0"))
          (set! state
                (assert-equal &state
                  36f
                  (Simd.get v-sub 3)
                  "Sub (-) idx 3 is 36.0"))
          (set! state
                (assert-equal &state
                  10f
                  (Simd.get v-mul 0)
                  "Mul (*) idx 0 is 10.0"))
          (set! state
                (assert-equal &state
                  160f
                  (Simd.get v-mul 3)
                  "Mul (*) idx 3 is 160.0"))
          (set! state
                (assert-equal &state
                  10f
                  (Simd.get v-div 0)
                  "Div (/) idx 0 is 10.0"))
          (set! state
                (assert-equal &state
                  10f
                  (Simd.get v-div 3)
                  "Div (/) idx 3 is 10.0"))
          (set! state
                (assert-equal &state
                  -1f
                  (Simd.get v-neg 0)
                  "Neg (neg) idx 0 is -1.0"))
          (set! state
                (assert-equal &state
                  -4f
                  (Simd.get v-neg 3)
                  "Neg (neg) idx 3 is -4.0"))))

      ;; 3. Math, FMA, Clamp, and Reductions
      (let [v-sum4 (Simd.sum-4 v1)
            v-min4 (Simd.min-4 (Simd.init-4 10f 20f 30f 40f))
            v-max4 (Simd.max-4 (Simd.init-4 -10f -20f -30f -40f))
            v-sqrt (Simd.sqrt (Simd.init-4 4f 9f 16f 25f))
            v-rsqrt (Simd.rsqrt (Simd.init-4 4f 16f 25f 100f))
            v-clamp (Simd.clamp (Simd.init-4 -5f 5f 15f 25f)
                                (Simd.splat 0f)
                                (Simd.splat 10f))
            v-fma (Simd.fma v1 v2 (Simd.splat 5f))]
        (do
          (set! state (assert-equal &state 10f v-sum4 "Sum-4 is 10.0"))
          (set! state
                (assert-equal &state
                  10f
                  v-min4
                  "Min-4 of positive values is 10.0"))
          (set! state
                (assert-equal &state
                  -10f
                  v-max4
                  "Max-4 of negative values is -10.0"))
          (set! state
                (assert-equal &state 2f (Simd.get v-sqrt 0) "Sqrt of 4 is 2.0"))
          (set! state
                (assert-equal &state 5f (Simd.get v-sqrt 3) "Sqrt of 25 is 5.0"))
          (set! state
                (assert-equal &state
                  0.5f
                  (Simd.get v-rsqrt 0)
                  "Rsqrt of 4 is 0.5"))
          (set! state
                (assert-equal &state
                  0.1f
                  (Simd.get v-rsqrt 3)
                  "Rsqrt of 100 is 0.1"))
          (set! state
                (assert-equal &state
                  0f
                  (Simd.get v-clamp 0)
                  "Clamp -5 to [0,10] is 0"))
          (set! state
                (assert-equal &state
                  5f
                  (Simd.get v-clamp 1)
                  "Clamp 5 to [0,10] is 5"))
          (set! state
                (assert-equal &state
                  10f
                  (Simd.get v-clamp 2)
                  "Clamp 15 to [0,10] is 10"))
          (set! state
                (assert-equal &state
                  15f
                  (Simd.get v-fma 0)
                  "FMA (1*10+5) is 15.0"))
          (set! state
                (assert-equal &state
                  165f
                  (Simd.get v-fma 3)
                  "FMA (4*40+5) is 165.0"))))

      ;; 4. Vector Comparisons & Selection (Blend)
      (let [va (Simd.init-4 1f 20f 3f 40f)
            vb (Simd.init-4 10f 2f 30f 4f)
            mask (Simd.cmp-lt va vb)
            res (Simd.select mask va vb)]
        (do
          (set! state
                (assert-equal &state 1f (Simd.get res 0) "Select idx 0 is 1.0"))
          (set! state
                (assert-equal &state 2f (Simd.get res 1) "Select idx 1 is 2.0"))
          (set! state
                (assert-equal &state 3f (Simd.get res 2) "Select idx 2 is 3.0"))
          (set! state
                (assert-equal &state 4f (Simd.get res 3) "Select idx 3 is 4.0"))))

      ;; 5. Aligned Load & Store
      (let [v-load (Simd.load-aligned raw-data)]
        (do
          (set! state
                (assert-equal &state
                  100f
                  (Simd.get v-load 0)
                  "Aligned load idx 0 is 100.0"))
          (set! state
                (assert-equal &state
                  103f
                  (Simd.get v-load 3)
                  "Aligned load idx 3 is 103.0"))

          (Simd.store-aligned! data v-load)
          (set! state
                (assert-equal &state
                  100f
                  (Pointer.to-value (Pointer.add data 0l))
                  "Aligned store idx 0 is 100.0"))
          (set! state
                (assert-equal &state
                  103f
                  (Pointer.to-value (Pointer.add data 3l))
                  "Aligned store idx 3 is 103.0"))))

      ;; 6. Geometry primitives: dot, dot-4, len-4, normalize-4
      (let [v-geo (Simd.init-4 3f 4f 0f 0f)
            v-norm (Simd.normalize-4 v-geo)]
        (do
          (set! state
                (assert-equal &state
                  300f
                  (Simd.dot v1 v2)
                  "Full-width Dot product is 300.0"))
          (set! state
                (assert-equal &state 300f (Simd.dot-4 v1 v2) "Dot-4 is 300.0"))
          (set! state
                (assert-equal &state
                  5f
                  (Simd.len-4 v-geo)
                  "Len-4 of (3,4,0,0) is 5.0"))
          (set! state
                (assert-equal &state
                  0.6f
                  (Simd.get v-norm 0)
                  "Normalize-4 idx 0 is 0.6"))
          (set! state
                (assert-equal &state
                  0.8f
                  (Simd.get v-norm 1)
                  "Normalize-4 idx 1 is 0.8"))))

      ;; 7. High-level Carp Array Drivers (SimdArray)
      (let [arr-a [1f 2f 3f 4f 5f 6f]
            arr-b [10f 20f 30f 40f 50f 60f]
            arr-dst [0f 0f 0f 0f 0f 0f]
            arr-sum (SimdArray.sum &arr-a)]
        (do
          (SimdArray.add! &arr-dst &arr-a &arr-b)
          (set! state
                (assert-equal &state
                  11f
                  @(Array.unsafe-nth &arr-dst 0)
                  "SimdArray.add! idx 0 is 11.0"))
          (set! state
                (assert-equal &state
                  66f
                  @(Array.unsafe-nth &arr-dst 5)
                  "SimdArray.add! idx 5 is 66.0"))
          (set! state
                (assert-equal &state
                  21f
                  arr-sum
                  "SimdArray.sum of [1..6] is 21.0"))))

      ;; 8. Integer SIMD Twin (SimdInt) & Bitwise Ops
      (let [ia (Simd.int-splat 5)
            ib (Simd.int-splat 6)
            i-and (Simd.bit-and ia ib)
            i-or (Simd.bit-or ia ib)
            i-xor (Simd.bit-xor ia ib)
            i-not (Simd.bit-not ia)]
        (do
          (set! state
                (assert-equal &state
                  4
                  (Simd.int-get i-and 0)
                  "Bitwise AND (5 & 6) is 4"))
          (set! state
                (assert-equal &state
                  7
                  (Simd.int-get i-or 0)
                  "Bitwise OR (5 | 6) is 7"))
          (set! state
                (assert-equal &state
                  3
                  (Simd.int-get i-xor 0)
                  "Bitwise XOR (5 ^ 6) is 3"))
          (set! state
                (assert-equal &state
                  -6
                  (Simd.int-get i-not 0)
                  "Bitwise NOT (~5) is -6"))))

      ;; 9. Float-Int conversions
      (let [v-float (Simd.init-4 1.1f 2.9f -3.5f 4f)
            v-int (Simd.float-to-int v-float)
            v-back (Simd.int-to-float v-int)]
        (do
          (set! state
                (assert-equal &state
                  1
                  (Simd.int-get v-int 0)
                  "float-to-int 1.1 is 1"))
          (set! state
                (assert-equal &state
                  2
                  (Simd.int-get v-int 1)
                  "float-to-int 2.9 is 2 (truncated)"))
          (set! state
                (assert-equal &state
                  -3
                  (Simd.int-get v-int 2)
                  "float-to-int -3.5 is -3"))
          (set! state
                (assert-equal &state
                  1f
                  (Simd.get v-back 0)
                  "int-to-float 1 is 1.0"))))

      ;; 10. Strided Gather & Scatter
      (let [gather-base [0f 10f 20f 30f 40f 50f]
            scatter-base [0f 0f 0f 0f 0f 0f]
            indices (Simd.int-set
              (Simd.int-set
                (Simd.int-set (Simd.int-set (Simd.int-splat 0) 0 1) 1 3)
                2
                0)
              3
              5)
            v-gather (Simd.gather (Array.unsafe-raw &gather-base) indices)
            v-scatter-vals (Simd.init-4 100f 300f 99f 500f)]
        (do
          (set! state
                (assert-equal &state
                  10f
                  (Simd.get v-gather 0)
                  "Gathered idx 0 (base[1]) is 10.0"))
          (set! state
                (assert-equal &state
                  30f
                  (Simd.get v-gather 1)
                  "Gathered idx 1 (base[3]) is 30.0"))
          (set! state
                (assert-equal &state
                  0f
                  (Simd.get v-gather 2)
                  "Gathered idx 2 (base[0]) is 0.0"))
          (set! state
                (assert-equal &state
                  50f
                  (Simd.get v-gather 3)
                  "Gathered idx 3 (base[5]) is 50.0"))

          (Simd.scatter! (Array.unsafe-raw &scatter-base) indices v-scatter-vals)
          (set! state
                (assert-equal &state
                  99f
                  @(Array.unsafe-nth &scatter-base 0)
                  "Scatter base[0] is 99.0"))
          (set! state
                (assert-equal &state
                  100f
                  @(Array.unsafe-nth &scatter-base 1)
                  "Scatter base[1] is 100.0"))
          (set! state
                (assert-equal &state
                  300f
                  @(Array.unsafe-nth &scatter-base 3)
                  "Scatter base[3] is 300.0"))
          (set! state
                (assert-equal &state
                  500f
                  @(Array.unsafe-nth &scatter-base 5)
                  "Scatter base[5] is 500.0"))))

      ;; 11. 4x4 Matrix Transform
      (let [col0 (Simd.init-4 1f 0f 0f 0f)
            col1 (Simd.init-4 0f 2f 0f 0f)
            col2 (Simd.init-4 0f 0f 3f 0f)
            col3 (Simd.init-4 0f 0f 0f 4f)
            m (Simd.mat4-make col0 col1 col2 col3)
            v (Simd.splat 10f)
            res (Simd.mat4-mul-vec4 &m v)]
        (do
          (set! state
                (assert-equal &state
                  10f
                  (Simd.get res 0)
                  "Mat4 mul idx 0 is 10.0"))
          (set! state
                (assert-equal &state
                  20f
                  (Simd.get res 1)
                  "Mat4 mul idx 1 is 20.0"))
          (set! state
                (assert-equal &state
                  30f
                  (Simd.get res 2)
                  "Mat4 mul idx 2 is 30.0"))
          (set! state
                (assert-equal &state
                  40f
                  (Simd.get res 3)
                  "Mat4 mul idx 3 is 40.0"))))

      ;; 12. Memory Cleanup
      (Simd.free-aligned raw-data)
      (Simd.free-aligned data)
      state)))
